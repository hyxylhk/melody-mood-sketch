# ==========================================================================
# AI 情绪音乐日记 —— 环境变量模板
# --------------------------------------------------------------------------
# 使用方法（重要）：
#   1. 复制本文件，重命名为  .env
#        Windows:  copy .env.example .env
#        Mac/Linux: cp .env.example .env
#   2. 用记事本 / VSCode 打开 .env，填入你自己的密钥
#   3. 重启后端服务（改 .env 必须重启才生效）
#
# 安全提示：
#   .env 已被 .gitignore 排除，**绝对不要**把 .env 提交到 GitHub，
#   也不要把里面的密钥贴到聊天框 / 直播画面里。
#
# 【零密钥也能跑】：
#   本项目的音乐生成做了「离线兜底」设计 —— 不填任何 Key 也能完整演示，
#   会用本地算法按情绪合成一段 WAV 音乐。详见 README。
# ==========================================================================


# ============================ 一、基础服务配置 ============================
# 调试模式：True 时代码改动自动重载，生产环境务必设 False
APP_DEBUG=True

# 服务监听地址与端口。0.0.0.0 表示允许局域网内其他设备（手机/评委电脑）访问
APP_HOST=0.0.0.0
APP_PORT=8000

# SQLite 数据库文件路径（相对项目根目录）。首次运行自动创建，无需手动建表
DATABASE_URL=sqlite:///./storage/diary.db

# 生成的音乐文件存放目录
AUDIO_DIR=./storage/audio

# CORS 跨域白名单。逗号分隔；开发期填 * 表示允许任何来源
# （上线后建议改成具体域名，例如 https://your-site.com）
CORS_ORIGINS=*


# ============================ 二、大模型（情绪解析）============================
# 支持任何 OpenAI 兼容接口（DeepSeek / 通义 / Kimi / 智谱 / 硅基流动 / OpenAI 自己）
# 只需要改下面三行即可切换厂商。

# 各家 base_url 参考：
#   OpenAI   : https://api.openai.com/v1
#   DeepSeek : https://api.deepseek.com/v1
#   智谱     : https://open.bigmodel.cn/api/paas/v4
#   月之暗面 : https://api.moonshot.cn/v1
#   硅基流动 : https://api.siliconflow.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 你的 API Key（以 sk- 开头）
LLM_API_KEY=sk-在这里填你的密钥

# 使用的模型名
LLM_MODEL=deepseek-chat

# 请求超时秒数
LLM_TIMEOUT=30

# 没有填 Key 时是否自动降级为本地关键词分析（强烈建议 True，保证断网也能演示）
LLM_FALLBACK_ENABLED=True


# ============================ 三、音乐生成 ============================
# provider 可选值：
#   auto     —— 优先用云端 API，失败自动降级到本地合成（推荐，演示最稳）
#   local    —— 只用本地算法合成 WAV（零依赖零费用，秒出结果）
#   httpapi  —— 只调用第三方音乐生成 API（需要下面的 Key）
MUSIC_PROVIDER=auto

# ---- 第三方音乐生成 API（可选）----
# 支持 Suno 系列开放接口（如 https://api.sunoapi.org 等兼容服务）
# 留空则自动走本地合成
MUSIC_API_BASE_URL=
MUSIC_API_KEY=
MUSIC_API_TIMEOUT=120

# 云端生成通常需要轮询等待，这里限制最长等待时间（秒）
MUSIC_MAX_WAIT_SECONDS=120

# ---- 本地合成参数 ----
# 生成音乐时长（秒）。演示建议 20~30 秒，太长了用户等不及
# 本地合成的音乐时长（秒）。默认 35，与曲库片段长度保持一致。
MUSIC_DURATION_SECONDS=35
# 采样率（Hz）。44100 是 CD 音质；机器慢可改 22050
MUSIC_SAMPLE_RATE=44100
